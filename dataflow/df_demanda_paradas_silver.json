{
	"name": "df_demanda_paradas_silver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = iif(regexMatch(trim(FechaServicio), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio))), iif(regexMatch(trim(FechaServicio), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(FechaServicio), 'dd/MM/yyyy'), toDate(left(trim(FechaServicio), 10), 'yyyy-MM-dd'))),",
				"          codRuta = iif(regexMatch(upper(trim(RutaHistoricaId)), '^R12-[NS]$'), upper(trim(RutaHistoricaId)), concat('R-', lpad(regexExtract(trim(RutaHistoricaId), '([0-9]+)', 1), 2, '0')))) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = iif(startsWith(iifNull(upper(trim(RutaHistoricaId)), ''), 'RH-'), upper(trim(RutaHistoricaId)), case(codRuta == 'R-07' && FechaServicio <= toDate('2021-12-31'), 'RH-07-OLD', codRuta == 'R-07', 'RH-07-NEW', codRuta == 'R-12' && FechaServicio <= toDate('2022-12-31'), 'RH-12-OLD', codRuta == 'R12-N', 'RH-12-N', codRuta == 'R12-S', 'RH-12-S', concat('RH-', right(codRuta, 2)))),",
				"          ParadaHistoricaId = case(upper(trim(ParadaHistoricaId)) == 'MC-01' && FechaServicio <= toDate('2023-06-30'), 'P220-MC-OLD', upper(trim(ParadaHistoricaId)) == 'MC-01', 'P220-MC-NEW', upper(trim(ParadaHistoricaId))),",
				"          Franja = trim(Franja),",
				"          ValidacionesTarjeta = iifNull(toInteger(round(toDouble(replace(trim(ValidacionesTarjeta), ',', '.')))), 0),",
				"          Descensos = iifNull(toInteger(round(toDouble(replace(trim(Descensos), ',', '.')))), 0),",
				"          DemandaNoAtendida = iifNull(toInteger(round(toDouble(replace(trim(DemandaNoAtendida), ',', '.')))), 0),",
				"          Metodo = upper(trim(Metodo)),",
				"          AnioFuente = iifNull(toShort(trim(AnioFuente)), toShort(year(FechaServicio)))) ~> derivedColumn2",
				"derivedColumn2 derive(DemandaId = iif(length(iifNull(trim(DemandaId), '')) > 0, trim(DemandaId), concat('DM-', toString(AnioFuente), '-', left(md5(toString(FechaServicio, 'yyyy-MM-dd'), RutaHistoricaId, ParadaHistoricaId, Franja), 12)))) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}