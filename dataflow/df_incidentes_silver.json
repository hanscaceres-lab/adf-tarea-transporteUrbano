{
	"name": "df_incidentes_silver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(inicio_f = regexExtract(trim(FechaHoraInicio), '^([^ T]+)', 1),",
				"          inicio_h = iif(regexMatch(trim(FechaHoraInicio), '.*[0-9]{2}:[0-9]{2}.*'), concat(regexExtract(trim(FechaHoraInicio), '([0-9]{2}:[0-9]{2})', 1), ':00'), '00:00:00'),",
				"          fin_f = regexExtract(trim(FechaHoraFin), '^([^ T]+)', 1),",
				"          fin_h = iif(regexMatch(trim(FechaHoraFin), '.*[0-9]{2}:[0-9]{2}.*'), concat(regexExtract(trim(FechaHoraFin), '([0-9]{2}:[0-9]{2})', 1), ':00'), '00:00:00'),",
				"          reg_f = regexExtract(trim(FechaHoraRegistro), '^([^ T]+)', 1),",
				"          reg_h = iif(regexMatch(trim(FechaHoraRegistro), '.*[0-9]{2}:[0-9]{2}.*'), concat(regexExtract(trim(FechaHoraRegistro), '([0-9]{2}:[0-9]{2})', 1), ':00'), '00:00:00'),",
				"          IncidenteId = trim(IncidenteId),",
				"          AnioFuente = iifNull(toShort(trim(AnioFuente)), toShort(toInteger(substring(trim(IncidenteId), 4, 4)))),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion),",
				"          VehiculoId = iif(length(iifNull(trim(VehiculoId), '')) == 0, toString(null()), concat('V-', lpad(regexExtract(trim(VehiculoId), '([0-9]+)', 1), 3, '0')))) ~> derivedColumn1",
				"derivedColumn1 derive(inicio_f = iif(regexMatch(trim(inicio_f), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(inicio_f))), iif(regexMatch(trim(inicio_f), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(inicio_f), 'dd/MM/yyyy'), toDate(left(trim(inicio_f), 10), 'yyyy-MM-dd'))),",
				"          fin_f = iif(regexMatch(trim(fin_f), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(fin_f))), iif(regexMatch(trim(fin_f), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(fin_f), 'dd/MM/yyyy'), toDate(left(trim(fin_f), 10), 'yyyy-MM-dd'))),",
				"          reg_f = iif(regexMatch(trim(reg_f), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(reg_f))), iif(regexMatch(trim(reg_f), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(reg_f), 'dd/MM/yyyy'), toDate(left(trim(reg_f), 10), 'yyyy-MM-dd')))) ~> derivedColumn2",
				"derivedColumn2 derive(FechaHoraInicio = toTimestamp(concat(toString(inicio_f, 'yyyy-MM-dd'), ' ', inicio_h), 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraFin = toTimestamp(concat(toString(fin_f, 'yyyy-MM-dd'), ' ', fin_h), 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraRegistro = toTimestamp(concat(toString(reg_f, 'yyyy-MM-dd'), ' ', reg_h), 'yyyy-MM-dd HH:mm:ss')) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}