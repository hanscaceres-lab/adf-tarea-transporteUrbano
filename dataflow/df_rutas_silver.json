{
	"name": "df_rutas_silver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VigenciaDesde = iif(regexMatch(trim(VigenciaDesde), '^[0-9]{5}$'),     addDays(toDate('1899-12-30'), toInteger(trim(VigenciaDesde))),     iif(regexMatch(trim(VigenciaDesde), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),         toDate(trim(VigenciaDesde), 'dd/MM/yyyy'),         toDate(left(trim(VigenciaDesde), 10), 'yyyy-MM-dd'))),",
				"          VigenciaHasta = iif(regexMatch(trim(VigenciaHasta), '^[0-9]{5}$'),\r",
				"    addDays(toDate('1899-12-30'), toInteger(trim(VigenciaHasta))),\r",
				"    iif(regexMatch(trim(VigenciaHasta), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),\r",
				"        toDate(trim(VigenciaHasta), 'dd/MM/yyyy'),\r",
				"        toDate(left(trim(VigenciaHasta), 10), 'yyyy-MM-dd'))),",
				"          CodigoRuta = iif(regexMatch(upper(trim(CodigoRuta)), '^R12-[NS]$'), upper(trim(CodigoRuta)), concat('R-', lpad(regexExtract(trim(CodigoRuta), '([0-9]+)', 1), 2, '0'))),",
				"          NombreRuta = trim(NombreRuta),",
				"          Origen = trim(Origen),",
				"          Destino = trim(Destino),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = iif(startsWith(iifNull(upper(trim(RutaHistoricaId)), ''), 'RH-'), upper(trim(RutaHistoricaId)), case(CodigoRuta == 'R-07' && VigenciaHasta <= toDate('2021-12-31'), 'RH-07-OLD', CodigoRuta == 'R-07', 'RH-07-NEW', CodigoRuta == 'R-12' && VigenciaHasta <= toDate('2022-12-31'), 'RH-12-OLD', CodigoRuta == 'R12-N', 'RH-12-N', CodigoRuta == 'R12-S', 'RH-12-S', concat('RH-', right(CodigoRuta, 2))))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}