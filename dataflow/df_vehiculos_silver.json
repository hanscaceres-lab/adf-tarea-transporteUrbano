{
	"name": "df_vehiculos_silver",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = concat('V-', lpad(regexExtract(trim(VehiculoId), '([0-9]+)', 1), 3, '0')),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(round(toDouble(replace(trim(CapacidadEfectiva), ',', '.')))),",
				"          VigenciaDesde = iif(regexMatch(trim(VigenciaDesde), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(VigenciaDesde))), iif(regexMatch(trim(VigenciaDesde), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(VigenciaDesde), 'dd/MM/yyyy'), toDate(left(trim(VigenciaDesde), 10), 'yyyy-MM-dd'))),",
				"          VigenciaHasta = iif(regexMatch(trim(VigenciaHasta), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(VigenciaHasta))), iif(regexMatch(trim(VigenciaHasta), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(VigenciaHasta), 'dd/MM/yyyy'), toDate(left(trim(VigenciaHasta), 10), 'yyyy-MM-dd'))),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(VehiculoId),",
				"     Placa = first(Placa),",
				"          TipoVehiculo = first(TipoVehiculo),",
				"          CapacidadEfectiva = first(CapacidadEfectiva),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}