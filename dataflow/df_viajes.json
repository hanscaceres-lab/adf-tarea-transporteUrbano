{
	"name": "df_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = iif(regexMatch(trim(FechaServicio), '^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio))), iif(regexMatch(trim(FechaServicio), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(FechaServicio), 'dd/MM/yyyy'), toDate(left(trim(FechaServicio), 10), 'yyyy-MM-dd'))),",
				"          codRuta = iif(regexMatch(upper(trim(RutaHistoricaId)), '^R12-[NS]$'), upper(trim(RutaHistoricaId)), concat('R-', lpad(regexExtract(trim(RutaHistoricaId), '([0-9]+)', 1), 2, '0')))) ~> derivedColumn1",
				"derivedColumn1 derive(ViajeId = iif(startsWith(trim(ViajeId), 'VJ-'), trim(ViajeId), concat('VJ-', toString(year(FechaServicio)), '-', lpad(regexExtract(trim(ViajeId), '([0-9]+)', 1), 5, '0'))),",
				"          RutaHistoricaId = iif(startsWith(iifNull(upper(trim(RutaHistoricaId)), ''), 'RH-'), upper(trim(RutaHistoricaId)), case(codRuta == 'R-07' && FechaServicio <= toDate('2021-12-31'), 'RH-07-OLD', codRuta == 'R-07', 'RH-07-NEW', codRuta == 'R-12' && FechaServicio <= toDate('2022-12-31'), 'RH-12-OLD', codRuta == 'R12-N', 'RH-12-N', codRuta == 'R12-S', 'RH-12-S', concat('RH-', right(codRuta, 2)))),",
				"          VehiculoId = concat('V-', lpad(regexExtract(trim(VehiculoId), '([0-9]+)', 1), 3, '0')),",
				"          HoraProgramada = concat(regexExtract(trim(HoraProgramada), '([0-9]{2}:[0-9]{2})', 1), ':00'),",
				"          HoraSalida = concat(regexExtract(trim(HoraSalida), '([0-9]{2}:[0-9]{2})', 1), ':00'),",
				"          ValidacionesTarjeta = iifNull(toInteger(round(toDouble(replace(trim(ValidacionesTarjeta), ',', '.')))), 0),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos), ',', '.'), 8, 1),",
				"          EstadoViaje = upper(trim(EstadoViaje)),",
				"          HoraLlegada = concat(regexExtract(trim(HoraLlegada), '([0-9]{2}:[0-9]{2})', 1), ':00')) ~> derivedColumn2",
				"derivedColumn3 aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje),",
				"          codRuta = first(codRuta)) ~> aggregate1",
				"derivedColumn2 derive(HoraProgramada = toTimestamp(toString(trim(HoraProgramada)), \"yyyy-MM-dd' 'HH:mm:ss\"),",
				"          HoraSalida = toTimestamp(HoraSalida, 'HH:mm:ss'),",
				"          HoraLlegada = toTimestamp(HoraLlegada, 'HH:mm:ss')) ~> derivedColumn3",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}